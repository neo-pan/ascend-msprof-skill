graft src
include README.md
include requirements.txt
include requirements-dev.txt
include pyproject.toml
include scripts/check_dist_contents.py
global-exclude *.py[cod]
global-exclude __pycache__/*
prune .codex
prune .claude
prune .humanize
prune .pkl_memoize_py3
prune downloads
prune local-notes
prune profile
prune tests
prune tmp-downloads
