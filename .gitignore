!/tests/fixtures/real_cann852_baseline/*/analysis/profile_context.json
!/tests/fixtures/real_cann852_baseline/cube/analysis/profile_harness_run.json
!/tests/fixtures/real_cann852_baseline/vector/analysis/profile_harness_run.json
