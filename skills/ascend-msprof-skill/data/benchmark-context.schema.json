{
  "$defs": {
    "BenchmarkCitation": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "title": "Artifact",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "field_ref": {
          "title": "Field Ref",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "baseline",
                "candidate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "required": [
        "artifact",
        "field_ref"
      ],
      "title": "BenchmarkCitation",
      "type": "object"
    },
    "BenchmarkIssue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "missing",
            "invalid",
            "mismatch",
            "conflict"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/BenchmarkCitation"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "status",
        "reason_code",
        "sources"
      ],
      "title": "BenchmarkIssue",
      "type": "object"
    },
    "BenchmarkRecord": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Contract Version"
        },
        "measurement_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Measurement Id"
        },
        "producer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Producer"
            },
            {
              "type": "null"
            }
          ]
        },
        "collected_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Collected At"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subject"
            },
            {
              "type": "null"
            }
          ]
        },
        "workload": {
          "anyOf": [
            {
              "$ref": "#/$defs/Workload"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Tensor"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inputs"
        },
        "outputs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Tensor"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outputs"
        },
        "input_identity": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "digest": "#/$defs/DigestIdentity",
                  "generator": "#/$defs/GeneratorIdentity"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/DigestIdentity"
                },
                {
                  "$ref": "#/$defs/GeneratorIdentity"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Identity"
        },
        "correctness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Correctness"
            },
            {
              "type": "null"
            }
          ]
        },
        "protocol": {
          "anyOf": [
            {
              "$ref": "#/$defs/Protocol"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Environment"
            },
            {
              "type": "null"
            }
          ]
        },
        "measurement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Measurement"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Failure"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contract_version",
        "measurement_id",
        "producer",
        "collected_at",
        "subject",
        "workload",
        "inputs",
        "outputs",
        "input_identity",
        "correctness",
        "protocol",
        "environment",
        "measurement",
        "failure"
      ],
      "title": "BenchmarkRecord",
      "type": "object"
    },
    "BenchmarkSource": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "title": "Artifact",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "entrypoints": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Entrypoints",
          "type": "array"
        }
      },
      "required": [
        "artifact",
        "sha256",
        "entrypoints"
      ],
      "title": "BenchmarkSource",
      "type": "object"
    },
    "Correctness": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/Reference"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "tolerances": {
          "additionalProperties": {
            "minimum": 0,
            "type": "number"
          },
          "title": "Tolerances",
          "type": "object"
        },
        "case_count": {
          "exclusiveMinimum": 0,
          "title": "Case Count",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "subject_id",
        "reference",
        "method",
        "tolerances",
        "case_count"
      ],
      "title": "Correctness",
      "type": "object"
    },
    "Device": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "id",
        "count"
      ],
      "title": "Device",
      "type": "object"
    },
    "DigestIdentity": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "digest",
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sha256"
      ],
      "title": "DigestIdentity",
      "type": "object"
    },
    "Environment": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "$ref": "#/$defs/Device"
        },
        "driver_version": {
          "title": "Driver Version",
          "type": "string"
        },
        "runtimes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Runtimes",
          "type": "object"
        },
        "control_policy": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Control Policy",
          "type": "object"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "device",
        "driver_version",
        "runtimes",
        "control_policy",
        "source"
      ],
      "title": "Environment",
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "anyOf": [
            {
              "enum": [
                "compile",
                "correctness",
                "timing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stage"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Message"
        }
      },
      "required": [
        "stage",
        "message"
      ],
      "title": "Failure",
      "type": "object"
    },
    "GeneratorIdentity": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "generator",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "name",
        "version",
        "parameters",
        "seed"
      ],
      "title": "GeneratorIdentity",
      "type": "object"
    },
    "Implementation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "id",
        "source"
      ],
      "title": "Implementation",
      "type": "object"
    },
    "JsonValue": {},
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "value_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Ms"
        },
        "statistic": {
          "anyOf": [
            {
              "enum": [
                "mean",
                "median"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Statistic"
        },
        "sample_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sample Count"
        }
      },
      "required": [
        "value_ms",
        "statistic",
        "sample_count"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "Producer",
      "type": "object"
    },
    "Protocol": {
      "additionalProperties": false,
      "properties": {
        "natural": {
          "title": "Natural",
          "type": "boolean"
        },
        "timer": {
          "$ref": "#/$defs/Producer"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "synchronization": {
          "title": "Synchronization",
          "type": "string"
        },
        "warmup": {
          "minimum": 0,
          "title": "Warmup",
          "type": "integer"
        },
        "cache_policy": {
          "title": "Cache Policy",
          "type": "string"
        },
        "reuse_policy": {
          "title": "Reuse Policy",
          "type": "string"
        },
        "concurrency": {
          "title": "Concurrency",
          "type": "string"
        },
        "sample_unit": {
          "title": "Sample Unit",
          "type": "string"
        },
        "calls_per_sample": {
          "exclusiveMinimum": 0,
          "title": "Calls Per Sample",
          "type": "integer"
        },
        "normalization": {
          "title": "Normalization",
          "type": "string"
        },
        "independence": {
          "title": "Independence",
          "type": "string"
        },
        "execution_order": {
          "title": "Execution Order",
          "type": "string"
        }
      },
      "required": [
        "natural",
        "timer",
        "scope",
        "synchronization",
        "warmup",
        "cache_policy",
        "reuse_policy",
        "concurrency",
        "sample_unit",
        "calls_per_sample",
        "normalization",
        "independence",
        "execution_order"
      ],
      "title": "Protocol",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope"
        },
        "implementation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Implementation"
            },
            {
              "type": "null"
            }
          ]
        },
        "build": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Build"
        }
      },
      "required": [
        "scope",
        "implementation",
        "build"
      ],
      "title": "Subject",
      "type": "object"
    },
    "Tensor": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "dtype": {
          "title": "Dtype",
          "type": "string"
        },
        "shape": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "stride": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Stride",
          "type": "array"
        },
        "layout": {
          "title": "Layout",
          "type": "string"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "dtype",
        "shape",
        "stride",
        "layout",
        "offset"
      ],
      "title": "Tensor",
      "type": "object"
    },
    "Workload": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "shape": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "dtype": {
          "title": "Dtype",
          "type": "string"
        },
        "case_count": {
          "exclusiveMinimum": 0,
          "title": "Case Count",
          "type": "integer"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "id",
        "shape",
        "dtype",
        "case_count",
        "parameters"
      ],
      "title": "Workload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "imports": {
      "items": {
        "$ref": "#/$defs/BenchmarkSource"
      },
      "title": "Imports",
      "type": "array"
    },
    "measurement": {
      "anyOf": [
        {
          "$ref": "#/$defs/BenchmarkRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/BenchmarkIssue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "imports",
    "measurement",
    "issues"
  ],
  "title": "BenchmarkContext",
  "type": "object"
}
