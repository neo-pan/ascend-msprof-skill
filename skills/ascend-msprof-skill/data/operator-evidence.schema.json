    "SameRecordCell": {
      "additionalProperties": false,
      "description": "Another recognized cell on the representative observation's CSV record.",
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "statistic": {
          "enum": [
            "duration",
            "ratio",
            "percentage",
            "bandwidth",
            "volume",
            "estimated_volume",
            "frequency"
          ],
          "title": "Statistic",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "value",
        "unit",
        "statistic"
      ],
      "title": "SameRecordCell",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "title": "Artifact",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
