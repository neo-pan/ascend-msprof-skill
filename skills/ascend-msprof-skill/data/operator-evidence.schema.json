        "derived_pipe_quotients": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DerivedPipeQuotient"
          },
          "title": "Derived Pipe Quotients",
          "type": "array"
        }
      },
      "required": [
        "metric",
        "value",
        "unit",
        "statistic",
        "name",
        "source",
        "raw_token"
      ],
      "title": "OperatorObservation",
      "type": "object"
    },
    "ParseIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "impact": {
          "enum": [
            "decode",
            "structure",
            "metric",
            "scope"
