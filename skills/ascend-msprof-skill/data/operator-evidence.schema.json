  "additionalProperties": false,
  "properties": {
    "group": {
      "enum": [
        "op_basic_info",
        "pipe_utilization",
        "arithmetic_utilization",
        "memory",
        "l2_cache",
        "resource_conflict"
      ],
      "title": "Group",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/OperatorArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "primary": {
      "$ref": "#/$defs/PrimarySelection"
    }
  },
  "required": [
    "group",
    "artifacts",
    "primary"
  ],
  "title": "OperatorEvidence",
  "type": "object"
}
