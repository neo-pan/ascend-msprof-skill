{
  "$defs": {
    "CoreTimeDistribution": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "scope": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Scope",
          "type": "array"
        },
        "valid_count": {
          "minimum": 1,
          "title": "Valid Count",
          "type": "integer"
        },
        "median_us": {
          "minimum": 0,
          "title": "Median Us",
          "type": "number"
        },
        "maximum": {
          "$ref": "#/$defs/OperatorObservation"
        },
        "second_largest": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperatorObservation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "metric",
        "scope",
        "valid_count",
        "median_us",
        "maximum",
        "second_largest"
      ],
      "title": "CoreTimeDistribution",
      "type": "object"
    },
    "DerivedPipeQuotient": {
      "additionalProperties": false,
      "description": "Same-row pipe_time / core_time. Not CalRatio and not a headline replacement.",
      "properties": {
        "numerator": {
          "title": "Numerator",
          "type": "string"
        },
        "denominator": {
          "title": "Denominator",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "recorded_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded Ratio"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "value"
      ],
      "title": "DerivedPipeQuotient",
      "type": "object"
    },
    "FieldPopulation": {
      "additionalProperties": false,
      "description": "Legal population of one metric within one artifact and core-class scope.",
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "statistic": {
          "enum": [
            "volume",
            "estimated_volume",
            "ratio",
            "percentage",
            "bandwidth"
          ],
          "title": "Statistic",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "scope": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Scope",
          "type": "array"
        },
        "valid_count": {
          "minimum": 1,
          "title": "Valid Count",
          "type": "integer"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        },
        "median": {
          "title": "Median",
          "type": "number"
        },
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "sum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sum"
        },
        "aggregation": {
          "enum": [
            "population_over_rows",
            "sum_over_rows"
          ],
          "title": "Aggregation",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "statistic",
        "unit",
        "scope",
        "valid_count",
        "minimum",
        "median",
        "maximum",
        "aggregation"
      ],
      "title": "FieldPopulation",
      "type": "object"
    },
    "LaunchCount": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "duration_us": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Us"
        }
      },
      "required": [
        "name",
        "count",
        "duration_us"
      ],
      "title": "LaunchCount",
      "type": "object"
    },
    "MetadataObservation": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Value"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "raw_token": {
          "title": "Raw Token",
          "type": "string"
        },
        "aliases": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Aliases",
          "type": "array"
        }
      },
      "required": [
        "metric",
        "value",
        "source",
        "raw_token"
      ],
      "title": "MetadataObservation",
      "type": "object"
    },
    "OperatorArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "title": "Artifact",
          "type": "string"
        },
        "group": {
          "title": "Group",
          "type": "string"
        },
        "parser": {
          "const": "csv",
          "default": "csv",
          "title": "Parser",
          "type": "string"
        },
        "segment": {
          "title": "Segment",
          "type": "string"
        },
        "metric_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Metric Scope"
        },
        "status": {
          "enum": [
            "parsed",
            "empty",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "sample_rows": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Sample Rows",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ParseIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/OperatorObservation"
          },
          "title": "Observations",
          "type": "array"
        },
        "launch_counts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LaunchCount"
          },
          "title": "Launch Counts",
          "type": "array"
        },
        "metadata": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MetadataObservation"
          },
          "title": "Metadata",
          "type": "array"
        },
        "core_time_distributions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CoreTimeDistribution"
          },
          "title": "Core Time Distributions",
          "type": "array"
        },
        "field_populations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FieldPopulation"
          },
          "title": "Field Populations",
          "type": "array"
        }
      },
      "required": [
        "artifact",
        "group",
        "segment",
        "metric_scope",
        "status",
        "columns",
        "row_count",
        "sample_rows",
        "issues",
        "observations"
      ],
      "title": "OperatorArtifact",
      "type": "object"
    },
    "OperatorObservation": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
