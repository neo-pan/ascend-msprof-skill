        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "statistic": {
          "enum": [
            "duration",
            "total",
            "average",
            "minimum",
            "maximum",
            "ratio",
            "percentage",
            "bandwidth",
            "volume",
            "estimated_volume",
            "frequency"
          ],
          "title": "Statistic",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "scope": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Scope",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "raw_token": {
          "title": "Raw Token",
          "type": "string"
        },
        "aliases": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Aliases",
          "type": "array"
        },
        "metric_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
